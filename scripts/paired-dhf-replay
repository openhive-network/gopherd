#!/usr/bin/env bash
# scripts/paired-dhf-replay — replay the same post-HF21 window twice, once with
# a baseline binary and once with the current one, and diff the results.
#
# Why paired rather than a single "does it pass" run. The DHF changes (the
# proposal removal budget, the per-block sweep, the HF29 gates) only do
# anything from HF21 onward, and a clean single run proves only that the chain
# still applies — not that it applies the SAME way. Block ids do not commit to
# state, so two binaries can agree on every id and disagree on the state behind
# it; that is how three consensus bugs hid during the testnet work. Diffing two
# runs of the same window is what catches a silent change.
#
# The window starts at a snapshot taken just after HF21 (35,921,786), so
# proposals, votes, remove_proposal and the new removal sweep are all live from
# the first block applied.
#
# Pick the COUNT from where the ops actually are, not from a round number.
# `GOPHERD_GOVSWEEP_DUMP_REMOVALS=1 gopherd govsweep-scan <events.gob>` lists
# every block carrying a remove_proposal op: there are 66 in the whole
# post-HF21 chain. The removal evaluator only runs when one appears, so a
# window chosen for its size can easily contain none — and a paired replay
# over that window compares two runs that never executed the changed path and
# calls it a pass. 200000 blocks from this snapshot covers five of them.
#
# Invariants are CHECKED but not allowed to stop the run, which looks wrong
# until you try it: /home/martin/gosnap35930/block-35930000 carries a
# pre-existing HBD imbalance of +878 satoshi, and it fails on the very FIRST
# block applied with the same delta — so it is in the snapshot, not in the
# replay. Letting it abort means the comparison can never run at all. Instead
# both sides log it, and the INVARIANT lines are part of the diff: if the
# change under test altered conservation, the two sides would report DIFFERENT
# deltas. A shared pre-existing delta is exactly what a clean result looks
# like here.
#
# Usage: scripts/paired-dhf-replay <base_binary> <head_binary> <snapshot_dir> <count> [outdir]
set -euo pipefail

BASE=${1:?base binary}
HEAD=${2:?head binary}
SNAP=${3:?snapshot dir}
COUNT=${4:?block count}
OUT=${5:-/home/martin/paired-dhf}

BLOCKLOG=${BLOCKLOG:-/home/martin/blocklog-full/block_log}

# The 35.93M snapshot carries a 20.3GB comment_store, and --comment-resident-cap
# keeps millions of comments in RAM on top of that. A 15G cap (the figure the
# replay-safety habit uses for genesis-anchored runs) gets the loader OOM-killed
# at 98% of the comment_store — which looks like a hang followed by a bare
# "Killed", so it is worth naming here rather than rediscovering.
#
# 27G leaves the OS ~4G on a 31G box. Nothing else heavy may run alongside this.
# 22G, not 27G: a 27G cap on a 31G box was OOM-killed (exit 137) 170k blocks
# into the replay — not during the load — and left the machine with zero
# available memory, which is enough pressure for a supervisor to start reaping
# other processes. Headroom is part of the configuration, not slack.
MEMMAX=${MEMMAX:-22G}
# Comments held in RAM; the rest spill to the cold tier. 4M is the value that
# avoids the EvictFrozen thrash seen with 1M in the high-volume era. Both sides
# use the same value, so it cannot skew the comparison.
# 1.5M rather than 4M. The 4M figure avoids EvictFrozen thrash in the
# high-volume era (58M+); at 36M there are far fewer live comments, so holding
# 4M of them is paying the peak cost for a window that does not need it.
RESIDENT_CAP=${RESIDENT_CAP:-1500000}

mkdir -p "$OUT"

# Disk guard: a replay that fills the disk corrupts whatever it was writing.
AVAIL=$(df --output=avail -BG /home/martin | tail -1 | tr -dc '0-9')
if [ "$AVAIL" -lt 50 ]; then
  echo "refusing to start: only ${AVAIL}G free on /home/martin" >&2
  exit 1
fi

run_one() {
  local name=$1 bin=$2
  echo "=== $name ($(md5sum "$bin" | cut -c1-12)) ==="
  # Each side gets its OWN state dir and cold dir. Sharing either would let the
  # first run's state leak into the second, which is the one way this
  # comparison can quietly prove nothing.
  rm -rf "$OUT/$name.state" "$OUT/$name.cold"
  mkdir -p "$OUT/$name.state" "$OUT/$name.cold"
  systemd-run --user --scope -q -p MemoryMax="$MEMMAX" -p MemorySwapMax=0 \
    "$bin" replay \
      --load-snapshot "$SNAP" \
      --count "$COUNT" \
      --data-dir "$OUT/$name.state" \
      --cold-dir "$OUT/$name.cold" \
      --comment-resident-cap "$RESIDENT_CAP" \
      --check-invariants 100000 \
      --check-invariants-stop=false \
      --progress-every 250000 \
      --shutdown-snapshot-dir "$OUT/$name.snap" \
      "$BLOCKLOG" 2>&1 | tee "$OUT/$name.log" | tail -30
}

# A killed run must not fall through to the diff: two truncated logs compare
# equal and would read as a pass. set -e plus pipefail aborts the script, and
# this trap explains what happened instead of leaving a bare "Killed".
trap 'rc=$?; if [ $rc -ne 0 ]; then
  echo;
  if [ $rc -eq 137 ]; then
    echo "OOM-KILLED (exit 137) with MEMMAX=$MEMMAX RESIDENT_CAP=$RESIDENT_CAP."
    echo "Lower RESIDENT_CAP first: raising MEMMAX past the box'"'"'s headroom"
    echo "starves everything else and invites a supervisor to reap it."
  else
    echo "ABORTED (exit $rc). Check the tail of $OUT/*.log."
  fi
fi' EXIT

run_one base "$BASE"
run_one head "$HEAD"

echo
echo "=== summary diff (base vs head) ==="
# Compare the parts of the summary that describe STATE, not timing. A rate or
# an elapsed line differing is meaningless; a head block, an op count or an
# invariant result differing is the whole point.
for f in base head; do
  # INVARIANT lines are included deliberately — see the header. They must match
  # between the two sides; a differing delta is the signal, a shared one is not.
  grep -E "blocks applied|ops applied|ops skipped|block errors|head block|dgpo time|dgpo witness|status|rc stale max|govsweep budget|INVARIANT" \
    "$OUT/$f.log" > "$OUT/$f.summary" || true
done
if diff -u "$OUT/base.summary" "$OUT/head.summary"; then
  echo "SUMMARIES IDENTICAL"
else
  echo "SUMMARIES DIFFER — investigate before trusting the change"
  exit 1
fi
