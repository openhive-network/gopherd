#!/usr/bin/env bash
# scripts/testnet-down — stop every node of the local mixed testnet.
# Data directories are left intact so the chain can be restarted.
set -euo pipefail
for p in hived gopherd-testnet; do
  if pgrep -x "$p" >/dev/null 2>&1; then
    echo "stopping $p"; pkill -x "$p" || true
  fi
done
for _ in $(seq 1 10); do
  pgrep -x hived >/dev/null 2>&1 || pgrep -x gopherd-testnet >/dev/null 2>&1 || { echo "all stopped"; exit 0; }
  sleep 1
done
pkill -9 -x hived 2>/dev/null || true
pkill -9 -x gopherd-testnet 2>/dev/null || true
echo "all stopped (forced)"
