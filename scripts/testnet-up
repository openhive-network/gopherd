#!/usr/bin/env bash
# scripts/testnet-up — bring up a MIXED hived + gopherd testnet.
#
# Usage:
#   scripts/testnet-up [hived_testnet_binary]
#
# Starts, all on localhost:
#   hived1   p2p 2101  rpc 8751   produces initminer + wit-a   (genesis producer)
#   hived2   p2p 2102  rpc 8752   produces wit-b
#   gopherd  p2p 2201  rpc 8791   produces wit-c + wit-d
#
# Then elects the witnesses (a fresh testnet gives its init_witnesses no votes,
# so without this only initminer ever produces) and waits until every node
# agrees on the head.
#
# Requires a TESTNET hived build (node_type "testnet"); a mainnet hived uses a
# different chain id and will not peer.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
HIVED=${1:-/home/martin/projects/hive/build_testnet/programs/hived/hived}
TN=${TESTNET_DIR:-/home/martin/testnet}
KEY=5JNHfZYKGaomSFvd4NUdQ9qMcEAC43kujbfjueTHpVapX1Kzq2n   # hived's default --skeleton-key
WITNESSES=wit-a,wit-b,wit-c,wit-d

[[ -x "$HIVED" ]] || { echo "no hived testnet binary at $HIVED" >&2; exit 1; }
"$HIVED" --version 2>/dev/null | grep -q '"node_type":"testnet"' || {
  echo "$HIVED is not a testnet build (needs node_type testnet)" >&2; exit 1; }

echo "==> building gopherd (testnet)"
(cd "$ROOT" && go build -tags testnet -o bin/gopherd-testnet ./cmd/gopherd)

mkdir -p "$TN"/{hived1,hived2,gopherd1}
rm -rf "$TN"/hived1/blockchain "$TN"/hived2/blockchain "$TN"/gopherd1/data

# genesis_time and hardfork_schedule are BOTH mandatory. Pinning genesis_time to
# gopherd's compile-time testnet constant keeps block slots aligned; scheduling
# hardfork 28 at block 1 starts the chain on current consensus rules, which is
# what gopherd's testnet build assumes.
cat > "$TN/chain-spec.json" <<EOF
{
  "genesis_time": 1451606400,
  "init_witnesses": ["wit-a", "wit-b", "wit-c", "wit-d"],
  "hardfork_schedule": [{"hardfork": 28, "block_num": 1}]
}
EOF

hived_conf() { # $1=dir $2=p2p $3=rpc $4=witness-lines $5=stale
  cat > "$1/config.ini" <<EOF
p2p-endpoint = 127.0.0.1:$2
webserver-http-endpoint = 127.0.0.1:$3
shared-file-size = 2G
enable-stale-production = $5
required-participation = 0
$4
private-key = $KEY
plugin = witness database_api condenser_api block_api network_broadcast_api
plugin = account_by_key account_by_key_api rc_api p2p json_rpc webserver
log-appender = {"appender":"stderr","stream":"std_error"}
log-logger = {"name":"default","level":"info","appender":"stderr"}
EOF
}
hived_conf "$TN/hived1" 2101 8751 $'witness = "initminer"\nwitness = "wit-a"' true
hived_conf "$TN/hived2" 2102 8752 $'witness = "wit-b"\np2p-seed-node = 127.0.0.1:2101' false

printf 'wit-c %s\nwit-d %s\n' "$KEY" "$KEY" > "$TN/witness-keys.txt"
chmod 600 "$TN/witness-keys.txt"

echo "==> starting hived1 (genesis producer)"
( cd "$TN/hived1" && setsid nohup "$HIVED" --data-dir="$TN/hived1" \
    --alternate-chain-spec="$TN/chain-spec.json" > "$TN/hived1/run.log" 2>&1 & )
until grep -q "Generated block" "$TN/hived1/run.log" 2>/dev/null; do sleep 2; done

echo "==> electing witnesses (vest + vote as initminer)"
"$ROOT/bin/gopherd-testnet" testnet-bootstrap --witnesses="$WITNESSES" --endpoint=http://127.0.0.1:8751

echo "==> starting hived2 (wit-b)"
( cd "$TN/hived2" && setsid nohup "$HIVED" --data-dir="$TN/hived2" \
    --alternate-chain-spec="$TN/chain-spec.json" > "$TN/hived2/run.log" 2>&1 & )

echo "==> starting gopherd (wit-c, wit-d)"
# --produce requires --fork-switching: a produced block must stay reversible so
# the node can reorg off it if the network picks another block for that slot.
( cd "$ROOT" && setsid nohup env GOPHERD_RC_DEBUG=${GOPHERD_RC_DEBUG:-} ./bin/gopherd-testnet node \
    --data-dir="$TN/gopherd1/data" --backend=pebble --no-block-log --no-default-seeds \
    --extra-seed=127.0.0.1:2101,127.0.0.1:2102 \
    --p2p-endpoint=127.0.0.1:2201 --max-outbound-peers=4 \
    --api-endpoint=127.0.0.1:8791 \
    --init-witness="$WITNESSES" \
    --witness-keys="$TN/witness-keys.txt" \
    --produce --fork-switching --relay-transactions --p2p-serve \
    > "$TN/gopherd1/run.log" 2>&1 & )

echo "==> waiting for all three nodes to agree on a head"
for _ in $(seq 1 60); do
  h1=$(curl -s --max-time 5 -X POST http://127.0.0.1:8751 -H 'Content-Type: application/json' \
        -d '{"jsonrpc":"2.0","method":"database_api.get_dynamic_global_properties","params":{},"id":1}' \
        | sed -n 's/.*"head_block_number":\([0-9]*\).*/\1/p') || true
  hg=$(curl -s --max-time 5 -X POST http://127.0.0.1:8791 -H 'Content-Type: application/json' \
        -d '{"jsonrpc":"2.0","method":"database_api.get_dynamic_global_properties","params":{},"id":1}' \
        | sed -n 's/.*"head_block_number":\([0-9]*\).*/\1/p') || true
  if [[ -n "${h1:-}" && "${h1:-}" == "${hg:-}" ]]; then
    echo "all nodes at head $h1"
    echo "run scripts/testnet-status to verify block-id agreement and who is producing"
    exit 0
  fi
  sleep 3
done
echo "nodes did not converge; check $TN/*/run.log" >&2
exit 1
