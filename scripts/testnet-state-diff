#!/usr/bin/env bash
# scripts/testnet-state-diff — compare CHAIN STATE between hived and gopherd.
#
# Block ids matching proves the nodes agree on block CONTENTS, not on the state
# derived from them: Hive block ids do not commit to state. Every consensus bug
# found while making gopherd join a hived testnet (hardforks-at-block-1, the
# HF1 vesting-split ordering, the witness-pay normalization factor) showed up
# HERE while every block id still matched.
set -euo pipefail
python3 - <<'PY'
import json,urllib.request,time
def rpc(port):
    req=urllib.request.Request(f"http://127.0.0.1:{port}",
        data=json.dumps({"jsonrpc":"2.0","method":"database_api.get_dynamic_global_properties","params":{},"id":1}).encode(),
        headers={'Content-Type':'application/json'})
    return json.load(urllib.request.urlopen(req,timeout=8))['result']
h=g=None
for _ in range(30):
    h,g=rpc(8751),rpc(8791)
    if h['head_block_number']==g['head_block_number']: break
    time.sleep(1)
def amt(v): return v['amount'] if isinstance(v,dict) else v
fields=['head_block_number','current_supply','current_hbd_supply','total_vesting_shares',
        'total_vesting_fund_hive','virtual_supply','total_reward_fund_hive',
        'pending_rewarded_vesting_shares','hbd_interest_rate','hbd_print_rate']
mis=[]
print(f"  {'field':32} {'hived':>18} {'gopherd':>18}  ok")
for f in fields:
    if f not in h or f not in g: continue
    a,b=amt(h[f]),amt(g[f]); ok=a==b
    if not ok: mis.append(f)
    print(f"  {f:32} {str(a):>18} {str(b):>18}  {'yes' if ok else 'NO'}")
print("\n  mismatches:", mis if mis else "NONE")
PY
